// HR Management System — Database Schema
// Paste toàn bộ nội dung này vào https://dbdiagram.io/d

Table Role {
  id ObjectId [pk]
  name string [not null, note: 'admin | hr | employee | manager']
  permissions string[] [note: 'VD: attendance:approve, payroll:view']
  createdAt date
  updatedAt date
}

Table User {
  id ObjectId [pk]
  employeeId ObjectId [ref: - Employee.id, note: '1-1']
  roleId ObjectId [ref: > Role.id]
  username string [not null, unique]
  passwordHash string [not null]
  isActive boolean [default: true]
  lastLogin date
  createdAt date
  updatedAt date
}

Table Department {
  id ObjectId [pk]
  name string [not null]
  code string [unique, note: 'VD: DEV, HR, SALES']
  managerId ObjectId [ref: > Employee.id, note: 'Trưởng phòng']
  createdAt date
  updatedAt date
}

Table Position {
  id ObjectId [pk]
  title string [not null, note: 'VD: Senior Developer']
  level string [note: 'VD: L1, L2, Manager']
  departmentId ObjectId [ref: > Department.id]
  createdAt date
  updatedAt date
}

Table Employee {
  id ObjectId [pk]
  employeeCode string [not null, unique, note: 'Mã nhân viên']
  fullName string [not null]
  departmentId ObjectId [ref: > Department.id]
  positionId ObjectId [ref: > Position.id]
  team string
  block string [note: 'Khối']
  hireDate date [not null]
  gender string [note: 'MALE | FEMALE | OTHER']
  birthYear number
  idNumber string [not null, unique, note: 'CMND/CCCD']
  idIssueDate date
  idIssuePlace string
  permanentAddress string [note: 'Thường trú']
  temporaryAddress string [note: 'Tạm trú']
  phone string
  personalEmail string
  workEmail string
  photo string [note: 'URL ảnh đại diện']
  notes string
  createdAt date
  updatedAt date
}

Table Contract {
  id ObjectId [pk]
  employeeId ObjectId [ref: > Employee.id]
  contractType string [not null, note: 'PROBATION | FIXED | PERMANENT']
  probationStart date
  probationEnd date
  contractDate date
  contractEnd date
  noticePeriod number [note: 'Số ngày báo trước khi nghỉ']
  reSign boolean [default: false, note: 'Tái ký']
  resignationDate date
  salaryCommitFile string [note: 'URL file cam kết bảo mật lương']
  salaryGrossFile string [note: 'URL file cam kết lương gross']
  createdAt date
  updatedAt date
}

Table BankInfo {
  id ObjectId [pk]
  employeeId ObjectId [ref: > Employee.id]
  bankAccount string
  bankName string
  bankBranch string
  bankCode string
  createdAt date
  updatedAt date
}

Table Vehicle {
  id ObjectId [pk]
  employeeId ObjectId [ref: > Employee.id]
  vehicleLabel string [note: 'Nhãn xe: Honda, Yamaha...']
  vehicleColor string
  vehicleNumber string [note: 'Biển số xe']
  createdAt date
  updatedAt date
}

Table Shift {
  id ObjectId [pk]
  name string [not null, note: 'VD: Ca sáng, Ca tối']
  startTime string [not null, note: 'HH:mm — VD: 08:00']
  endTime string [not null, note: 'HH:mm — VD: 17:30']
  graceLateMinutes number [default: 0, note: 'Biên độ trễ cho phép']
  isDefault boolean [default: false]
  createdAt date
  updatedAt date
}



Table DeviceLog {
  id ObjectId [pk]
  deviceId string [not null, unique, note: 'ID từ máy chấm công']
  deviceName string
  ipAddress string
  location string [note: 'VD: Cổng chính, Tầng 2']
  isActive boolean [default: true]
  createdAt date
  updatedAt date
}

Table AttendanceLog {
  id ObjectId [pk]
  employeeId ObjectId [ref: > Employee.id]
  deviceId ObjectId [ref: > DeviceLog.id]
  timestamp date [not null, note: 'Thời điểm chấm công thô']
  source string [note: 'MACHINE | IMPORT']
  createdAt date

  indexes {
    (employeeId, timestamp)
  }
}

Table Attendance {
  id ObjectId [pk]
  employeeId ObjectId [ref: > Employee.id]
  shiftId ObjectId [ref: > Shift.id]
  date date [not null]
  checkIn date
  checkOut date
  workingHours number [default: 0]
  status string [note: 'ONTIME | LATE | EARLY_LEAVE | ABSENT | LEAVE_PAID | LEAVE_UNPAID | REMOTE']
  lateMinutes number [default: 0]
  earlyLeaveMinutes number [default: 0]
  isApproved boolean [default: false]
  isExempted boolean [default: false]
  isAbnormal boolean [default: false, note: 'Dữ liệu bất thường / lỗi']
  source string [note: 'AUTO | IMPORT | MANUAL']
  isManualEdit boolean [default: false]
  createdAt date
  updatedAt date

  indexes {
    (employeeId, date) [unique]
  }
}

Table LeaveBalance {
  id ObjectId [pk]
  employeeId ObjectId [ref: > Employee.id]
  year number [not null]
  totalDays number [default: 0]
  usedDays number [default: 0]
  remainingDays number [default: 0]
  carriedOver number [default: 0, note: 'Số ngày chuyển từ năm trước']
  createdAt date
  updatedAt date

  indexes {
    (employeeId, year) [unique]
  }
}

Table Request {
  id ObjectId [pk]
  employeeId ObjectId [ref: > Employee.id]
  approvedBy ObjectId [ref: > Employee.id, note: 'Người duyệt']
  attendanceId ObjectId [ref: > Attendance.id]
  type string [not null, note: 'LATE | EARLY_LEAVE | REMOTE | LEAVE | OTHER']
  fromDate date [not null]
  toDate date
  minutes number [note: 'Số phút trễ hoặc về sớm']
  durationType string [note: 'FULL_DAY | HALF_DAY']
  leaveType string [note: 'PAID | UNPAID']
  reason string
  status string [default: 'PENDING', note: 'PENDING | APPROVED | REJECTED']
  approvedAt date
  createdAt date
  updatedAt date
}



Table Payroll {
  id ObjectId [pk]
  employeeId ObjectId [ref: > Employee.id]
  
  month string [not null, note: 'YYYY-MM']
  baseSalary number [not null]
  allowances string [note: 'JSON array: [{name, amount, note}]']
  bonuses string [note: 'JSON array: [{name, amount, note}]']
  deductions string [note: 'JSON array: [{name, amount, note}]']
  totalAllowance number [default: 0]
  totalBonus number [default: 0]
  totalDeduction number [default: 0]
  netSalary number [note: 'Thực nhận']
  status string [default: 'PENDING', note: 'PENDING | APPROVED | PAID']
  note string
  createdAt date
  updatedAt date

  indexes {
    (employeeId, month) [unique]
  }
}

Table Notification {
  id ObjectId [pk]
  userId ObjectId [ref: > User.id]
  type string [note: 'REQUEST_APPROVED | PAYROLL_READY | CONTRACT_EXPIRING...']
  title string
  body string
  refModel string [note: 'Tên model liên quan: Request, Payroll...']
  refId ObjectId [note: 'ID bản ghi liên quan (polymorphic)']
  isRead boolean [default: false]
  readAt date
  createdAt date
}

Table AuditLog {
  id ObjectId [pk]
  userId ObjectId [ref: > User.id]
  action string [not null, note: 'CREATE | UPDATE | DELETE']
  targetModel string [not null, note: 'Tên model bị tác động']
  targetId ObjectId [not null, note: 'ID bản ghi bị tác động']
  oldValue string [note: 'JSON — giá trị trước khi thay đổi']
  newValue string [note: 'JSON — giá trị sau khi thay đổi']
  ipAddress string
  userAgent string
  createdAt date [not null]
}

